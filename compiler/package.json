{
  "name": "berkios-code",
  "version": "0.8.0",
  "description": "BERKIOS CODE: multilingual declarative application language (.bk), compiler and browser preview; BERKIOS Core (.bks) is a separate evolving typed language.",
  "keywords": [
    "berkios",
    "langage",
    "language",
    "dsl",
    "compiler",
    "compilateur",
    "français",
    "french",
    "multilingual",
    "low-code",
    "cli",
    "playground",
    "programming-language",
    "declarative-language",
    "domain-specific-language",
    "developer-tools",
    "application-development",
    "berkios-core"
  ],
  "license": "MIT",
  "author": "Berkios",
  "homepage": "https://graphic.berkios.online/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkiosbuinu-server/berkios_compiler.git",
    "directory": "compiler"
  },
  "bugs": {
    "url": "https://github.com/berkiosbuinu-server/berkios_compiler/issues"
  },
  "type": "module",
  "bin": {
    "berkios": "bin/berkios.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./browser": "./src/browser.mjs",
    "./web": "./web/berkios-web.mjs",
    "./web/*": "./web/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "web",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "berkios": "node bin/berkios.mjs",
    "build:web": "node scripts/build-web-examples.mjs",
    "prepublishOnly": "node scripts/build-web-examples.mjs && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
